{
  "openapi": "3.0.0",
  "info": {
    "title": "WhatsApp Reverse Auth API",
    "version": "1.0.0",
    "description": "Interactive documentation for the WhatsApp automation system."
  },
  "paths": {
    "/api/sessions": {
      "get": {
        "summary": "List all sessions",
        "tags": ["Sessions"],
        "responses": { "200": { "description": "Successful response" } }
      },
      "delete": {
        "summary": "Delete a session",
        "tags": ["Sessions"],
        "parameters": [
          { "name": "sessionId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Successful response" } }
      }
    },
    "/api/chats": {
      "get": {
        "summary": "Get chat list",
        "tags": ["Chats"],
        "parameters": [
          { "name": "sessionId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Successful response" } }
      }
    },
    "/api/messages": {
      "get": {
        "summary": "Get messages for a chat",
        "tags": ["Messages"],
        "parameters": [
          { "name": "chatId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Successful response" } }
      },
      "post": {
        "summary": "Send a message",
        "tags": ["Messages"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["chat_id", "session_id", "content"],
                "properties": {
                  "chat_id": { "type": "string", "format": "uuid" },
                  "session_id": { "type": "string" },
                  "content": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Successful response" } }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Search messages and chats",
        "tags": ["Search"],
        "parameters": [
          { "name": "sessionId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "query", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Successful response" } }
      }
    },
    "/api/auth/challenge": {
      "get": {
        "summary": "Check challenge status",
        "tags": ["Auth"],
        "parameters": [
          { "name": "token", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Challenge status returned" },
          "404": { "description": "Challenge not found or expired" }
        }
      },
      "post": {
        "summary": "Generate an authentication challenge",
        "tags": ["Auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "metadata": { "type": "object", "description": "Optional data to attach" },
                  "ttl": { "type": "integer", "default": 600, "description": "Time-to-live in seconds" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Challenge generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "whatsapp_url": { "type": "string", "nullable": true },
                    "bot_number": { "type": "string", "nullable": true },
                    "expiresAt": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
