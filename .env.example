# Environment variables for WhatsApp Reverse Auth Service

# API Server Configuration
PORT=3000
HOST=0.0.0.0

# Webhook URL - POST endpoint that will receive verification notifications
# Example: https://your-domain.com/api/webhook
WEBHOOK_URL=

# Bot Phone Number (optional) - The WhatsApp number where users should send tokens
# Format: Country code + number (e.g., 1234567890)
# If not set, a generic wa.me link will be generated
BOT_PHONE_NUMBER=

# Node Environment
NODE_ENV=production
